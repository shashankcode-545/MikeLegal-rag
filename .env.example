# Copy this file to .env and fill in your real key. .env is gitignored.

OPENROUTER_API_KEY=sk-or-your-key-here

# Level 1 uses a single fixed model (no routing yet). Any OpenRouter
# model id works, e.g. openai/gpt-4o-mini or a cheaper equivalent.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Model tiers (Level 2 routing maps to these). All from one model family
# per the assignment's constraint ("single model family" for routing).
# These are used as-is if left blank -- override any of them here if
# you want different models. Verify current OpenRouter pricing before
# relying on these against a small budget.
MODEL_TIER_LIGHT=meta-llama/llama-3.2-3b-instruct
MODEL_TIER_STANDARD=meta-llama/llama-3.1-8b-instruct
MODEL_TIER_STRONG=meta-llama/llama-3.1-70b-instruct
